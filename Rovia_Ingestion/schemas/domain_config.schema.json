{
  "$defs": {
    "DQDefaults": {
      "additionalProperties": false,
      "properties": {
        "result_columns": {
          "$ref": "#/$defs/ResultColumns",
          "default": {
            "errors": "_errors",
            "warnings": "_warnings"
          }
        },
        "variables_conf": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][\\w.]*$",
            "type": "string"
          },
          "title": "Variables Conf",
          "type": "array"
        }
      },
      "title": "DQDefaults",
      "type": "object"
    },
    "LayerEntry": {
      "additionalProperties": false,
      "properties": {
        "schema_conf": {
          "pattern": "^[A-Za-z][\\w.]*$",
          "title": "Schema Conf",
          "type": "string"
        },
        "table_properties": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Table Properties",
          "type": "object"
        }
      },
      "required": [
        "schema_conf"
      ],
      "title": "LayerEntry",
      "type": "object"
    },
    "MetadataColumn": {
      "additionalProperties": false,
      "description": "One operational-metadata column. Exactly one of:\n\n* ``expr`` \u2014 any SQL expression, evaluated per row at write time\n  (``current_timestamp()``, ``_metadata.file_path`` on file sources, \u2026);\n* ``value`` \u2014 a literal string; ``{domain}``/``{layer}``/``{dataset}``\n  tokens resolve at generation time;\n* ``conf`` \u2014 a pipeline-conf KEY resolved per environment and stamped\n  as a literal (the usual dev/stage/prod stamp).",
      "properties": {
        "conf": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][\\w.]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conf"
        },
        "expr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expr"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "MetadataColumn",
      "type": "object"
    },
    "OperationalMetadataSpec": {
      "additionalProperties": false,
      "description": "Domain-wide metadata columns stamped on every dataset frame \u2014 AFTER\ncolumn mapping and transforms (so a transform cannot drop them) and\nBEFORE data quality (so quarantine evidence carries them too). Datasets\nopt out with ``operational_metadata: false``.",
      "properties": {
        "columns": {
          "default": {},
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/MetadataColumn"
            }
          },
          "title": "Columns",
          "type": "object"
        }
      },
      "title": "OperationalMetadataSpec",
      "type": "object"
    },
    "ResultColumns": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "default": "_errors",
          "title": "Errors",
          "type": "string"
        },
        "warnings": {
          "default": "_warnings",
          "title": "Warnings",
          "type": "string"
        }
      },
      "title": "ResultColumns",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "config/<domain>/domain.yml \u2014 environment-agnostic domain settings.\n\nCatalog and schema values are pipeline-conf KEYS resolved per target\n(dev/stage/prod) through bundle variables \u2014 literal catalog names are\nrejected by design so promotion across environments never edits configs.",
  "properties": {
    "catalog_conf": {
      "default": "datalab.catalog",
      "pattern": "^[A-Za-z][\\w.]*$",
      "title": "Catalog Conf",
      "type": "string"
    },
    "domain": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "title": "Domain",
      "type": "string"
    },
    "dq": {
      "$ref": "#/$defs/DQDefaults",
      "default": {
        "result_columns": {
          "errors": "_errors",
          "warnings": "_warnings"
        },
        "variables_conf": []
      }
    },
    "imports": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Imports",
      "type": "array"
    },
    "layers": {
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "$ref": "#/$defs/LayerEntry"
        }
      },
      "title": "Layers",
      "type": "object"
    },
    "operational_metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationalMetadataSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "domain",
    "layers"
  ],
  "title": "DomainConfig",
  "type": "object"
}
