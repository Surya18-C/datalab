      "type": "integer"
    },
    "source": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "cloud_files": "#/$defs/CloudFilesSource",
              "files": "#/$defs/FileSource",
              "kafka": "#/$defs/KafkaSource",
              "python": "#/$defs/PythonSource",
              "snapshot_function": "#/$defs/SnapshotFunctionSource",
              "sql": "#/$defs/SqlSource",
              "table": "#/$defs/TableSource",
              "view": "#/$defs/ViewSource"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CloudFilesSource"
            },
            {
              "$ref": "#/$defs/FileSource"
            },
            {
              "$ref": "#/$defs/TableSource"
            },
            {
              "$ref": "#/$defs/ViewSource"
            },
            {
              "$ref": "#/$defs/KafkaSource"
            },
            {
              "$ref": "#/$defs/SnapshotFunctionSource"
            },
            {
              "$ref": "#/$defs/SqlSource"
            },
            {
              "$ref": "#/$defs/PythonSource"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FlowSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "target": {
      "discriminator": {
        "mapping": {
          "delta_sink": "#/$defs/DeltaSinkTarget",
          "foreach_batch_sink": "#/$defs/ForeachBatchSinkTarget",
          "kafka_sink": "#/$defs/KafkaSinkTarget",
          "materialized_view": "#/$defs/MaterializedViewTarget",
          "streaming_table": "#/$defs/StreamingTableTarget",
          "temporary_view": "#/$defs/TemporaryViewTarget"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StreamingTableTarget"
        },
        {
